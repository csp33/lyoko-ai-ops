# ==============================================================================
# LYOKO AIOps Configuration Example
# Copy this file to .env and fill in your credentials. DO NOT commit .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
# Cheaper model for chat, remediation, verification, subagents, and domain specialists.
OPENAI_CHEAP_MODEL=gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# Stronger model for the diagnose phase (synthesis + go/no-go). Empty falls back to OPENAI_CHEAP_MODEL.
OPENAI_DIAGNOSE_MODEL=gpt-4.1
# Use the OpenAI Responses API instead of Chat Completions (better tool/reasoning continuity).
OPENAI_USE_RESPONSES_API=true

# ------------------------------------------------------------------------------
# sector5-mcp Server Settings
# ------------------------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_TRANSPORT=http

# Authentication (Optional - Google OAuth, Service Token, HS256 JWT)
AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_EMAILS=
SERVICE_TOKEN=
JWT_SECRET=
BASE_URL=http://localhost:8080
REDIRECT_PATH=/oauth/callback

# Telegram Bot (for alert reporting, interactive assistant & HITL buttons)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890
TELEGRAM_DEFAULT_CHAT_ID=-1001234567890
TELEGRAM_DISCUSSION_GROUP_ID=-1001234567890

# Home Assistant (Optional)
HASS_URL=http://homeassistant.default.svc.cluster.local:8123
HASS_TOKEN=your-long-lived-access-token

# UniFi Network Controller (Optional)
UNIFI_HOST=https://192.168.1.1
UNIFI_USER=admin
UNIFI_PASSWORD=your-unifi-password
UNIFI_SITE=default

# Grafana (Optional)
GRAFANA_URL=http://grafana.monitoring.svc.cluster.local:3000
GRAFANA_TOKEN=your-grafana-service-account-token
GRAFANA_COMMAND=npx -y @grafana/mcp-server@latest

# GitHub MCP Upstream (Optional - for repo/chart inspection and GitOps PRs)
GITHUB_ENABLED=true
GITHUB_COMMAND=npx -y @modelcontextprotocol/server-github
GITHUB_TOKEN=ghp_your-personal-access-token
GITHUB_OWNER=your-github-username-or-org
GITHUB_ALLOWED_REPOS=["*"]
GITHUB_BLOCKED_REPOS=[]

# ------------------------------------------------------------------------------
# LYOKO Agent Settings
# ------------------------------------------------------------------------------
LYOKO_HOST=0.0.0.0
LYOKO_PORT=9000
MCP_SERVER_URL=http://localhost:8000/mcp
# Abort startup if the MCP gateway rejects the credentials or the URL is wrong (401/403/404)
MCP_FAIL_FAST=true

# Incident agent tool policy (glob patterns, comma-separated).
# State-changing tools run during remediation only after operator approval, unless listed here.
# Example: AUTO_APPROVED_TOOLS=resources_scale
AUTO_APPROVED_TOOLS=
# Tools the agent may call freely because they only read state. Leave unset to use the built-in
# inspection patterns (get_*, list_*, *_get, *_list, *_log, *_top, ...); setting it replaces them.
# READ_ONLY_TOOLS=
# Maximum tool-use iterations of each investigation, remediation, or verification run.
MAX_AGENT_STEPS=25
# Hermes Agent Settings
HERMES_VENV_PATH=.venv-hermes
HERMES_HOME=.hermes
HERMES_MEMORY_ENABLED=true
# When HERMES_SERVER_URL is set, LYOKO delegates agent execution to a remote/daemon Hermes service
# via WebSocket instead of running local python subprocesses.
HERMES_SERVER_URL=http://localhost:8642
MAX_TURNS_DIAGNOSE=4
MAX_TURNS_REMEDIATE=3
MAX_TURNS_CHAT=5
MAX_BUDGET_USD_PER_EVENT=0.10
CYCLE_DETECTION_WINDOW=2
# Maximum tool calls a single agent run may execute before it must summarize (bounds fan-out).
MAX_TOOL_CALLS_PER_RUN=20
# Maximum characters of a single tool result kept in context (longer results are truncated).
MAX_TOOL_OUTPUT_CHARS=8000
# Similarity floor for injecting semantic memories into incident diagnosis (default: 0.2).
# MEMORY_SIMILARITY_THRESHOLD=0.2
# Higher similarity floor for injecting memories into interactive chat (default: 0.5), so loosely
# related operator notes cannot hijack the request.
# CHAT_MEMORY_SIMILARITY_THRESHOLD=0.5

# Environment (e.g. 'local', 'homelab', 'production', 'development')
ENVIRONMENT=local

# Observability (Optional - Langfuse / OpenTelemetry)
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=local
# Idle seconds after which a chat starts a new Langfuse session (default: 900).
# Users can also send /new to start a new session, or reply to an alert message to
# continue that incident's session.
CHAT_SESSION_IDLE_TIMEOUT_SECONDS=900

# PostgreSQL Database (Episodic Memory & Advisory Locks)
POSTGRES_HOST=postgresql-rw.postgresql-cnpg.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_USER=lyoko
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=lyoko
# Alternatively, provide full URI:
# POSTGRES_URI=postgresql://lyoko:your-postgres-password@localhost:5432/lyoko

# Hermes gateway (optional)
# HERMES_API_KEY=
# Bearer token Hermes uses to reach Lyoko's gated MCP proxy (unset = proxy disabled)
# LYOKO_GATED_MCP_TOKEN=
